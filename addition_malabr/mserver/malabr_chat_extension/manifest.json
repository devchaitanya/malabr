{
  "manifest_version": 3,
  "name": "MALABR Chat",
  "version": "1.0",
  "description": "Phase 1 smoke test: streamed malabr.generate() from a content script.",
  "permissions": [
    "malabr",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}